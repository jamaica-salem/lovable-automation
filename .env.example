# ==============================================================================
# Lovable Automation Platform - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure your environment-specific credentials.
# NEVER commit the active .env file or real credentials to version control.
# ==============================================================================

# Application & Server
APP_NAME="Lovable Website Automation Platform"
DEBUG=false
HOST=127.0.0.1
PORT=8080

# Database Persistence
# SQLite WAL mode is automatically enforced on startup.
DATABASE_PATH=jobs.db

# Worker Concurrency & Flow Control
# Design Worker runs concurrently and buffers ahead of Lovable.
DESIGN_WORKER_CONCURRENCY=2
DESIGN_BUFFER_SIZE=3
DESIGN_TIMEOUT_SECONDS=75.0

# Lovable Worker: MANDATORY STRICT CONCURRENCY = 1 (Sequential Mutex)
# Do NOT increase concurrency beyond 1.
SKIP_BLOCKED_JOBS=false
LOVABLE_GENERATION_TIMEOUT_SECONDS=300.0
LOVABLE_PUBLISH_TIMEOUT_SECONDS=120.0
LOVABLE_VERIFY_TIMEOUT_SECONDS=15.0

# Vercel Deployment Worker Concurrency (Non-blocking conveyor)
VERCEL_WORKER_CONCURRENCY=2
VERCEL_DEPLOY_TIMEOUT_SECONDS=300.0
VERCEL_VERIFY_TIMEOUT_SECONDS=20.0

# Watchdog & Crash Recovery
STALE_JOB_TIMEOUT_SECONDS=600.0
WATCHDOG_INTERVAL_SECONDS=30.0
EXPONENTIAL_BACKOFF_BASE_SECONDS=2.0

# External Service Credentials (Set in production or use mock providers)
# Lovable Official MCP API (https://mcp.lovable.dev)
LOVABLE_API_KEY=your_lovable_api_key_here

# GitHub Personal Access Token (for repo creation and syncing)
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your_github_org_or_username

# Vercel API Token (for project linking and production deployments)
VERCEL_TOKEN=your_vercel_token_here

# Dribbble API (optional for live design search; fallback provided)
DRIBBBLE_CLIENT_ID=your_dribbble_client_id_here
DRIBBBLE_ACCESS_TOKEN=your_dribbble_access_token_here
